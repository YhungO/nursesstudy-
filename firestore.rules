rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.email == 'chigaemezuaugustine43@gmail.com' ||
         request.auth.uid == 'usr-admin-1');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin() || isOwner(userId) || !isAuthenticated();
    }

    // Academic Levels
    match /levels/{levelId} {
      allow read: if true;
      allow write: if true; // Managed by portal admin
    }

    // Nursing Subjects
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if true; // Managed by portal admin
    }

    // Study Notes & Materials
    match /notes/{noteId} {
      allow read: if true;
      allow write: if true; // Managed by portal admin
    }

    // CBT Questions Bank
    match /questions/{questionId} {
      allow read: if true;
      allow write: if true; // Managed by portal admin
    }

    // CBT Exams
    match /exams/{examId} {
      allow read: if true;
      allow write: if true; // Managed by portal admin
    }

    // Student Exam Attempts
    match /attempts/{attemptId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true; // Managed by portal admin
    }

    // Student Bookmarks
    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    // System Settings & Meta
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
